<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="Pages/Dashboard.aspx" />
      </files>
    </defaultDocument>

    <httpErrors errorMode="Detailed" />
    <asp scriptErrorSentToBrowser="true" />

    <handlers>
      <add name="ASPX" path="*.aspx" verb="*" modules="IsapiModule" scriptProcessor="c:\Windows\Microsoft.NET\Framework64\v4.0.30319\aspnet_isapi.dll" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="Redirect to Dashboard" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="/Pages/dashboard.aspx" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <system.web>
    <customErrors mode="Off" />
    <compilation debug="true" targetFramework="4.8" />
  </system.web>
</configuration>
